# Include in Backend-01's unprivileged Nginx http {} context. Substitute only
# the named ${...} placeholders, preserving Nginx's $variables. Never use eval.
limit_req_zone $binary_remote_addr zone=ipfs_publish:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=ipfs_gateway:10m rate=20r/s;

# Publishing is reachable only through Nebula and requires a certificate issued
# by a dedicated publisher CA. Never include this server in Cloudflare ingress.
server {
    listen 100.111.67.1:8444 ssl;
    server_name 100.111.67.1;
    ssl_certificate /etc/cryft/ipfs-tls/server.crt;
    ssl_certificate_key /etc/cryft/ipfs-tls/server.key;
    ssl_client_certificate /etc/cryft/ipfs-tls/publisher-ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 100.111.1.4;
    allow 100.111.67.1;
    deny all;
    client_max_body_size 70m;
    limit_req_status 429;
    location ~ ^/api/v0/(add|cat|pin/ls)$ {
        if ($request_method != POST) { return 405; }
        limit_req zone=ipfs_publish burst=100 nodelay;
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:5001;
        proxy_set_header Connection "";
        proxy_set_header Origin "";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_cache off;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }
    location / { return 404; }
}

# Read-only gateway on a dedicated hostname. A persistent Backend-01 Cloudflare
# Tunnel targets this localhost listener. It must not share site/auth cookies.
server {
    listen 127.0.0.1:8080;
    server_name ${IPFS_PUBLIC_GATEWAY_HOSTNAME};
    # All clients arrive from the local tunnel. A bounded shared quota is the
    # safe initial default; add trusted real-client IP handling with the main
    # ingress policy before applying independent per-user limits.
    limit_req_status 429;
    location /ipfs/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        limit_req zone=ipfs_gateway burst=100 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8081;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        proxy_read_timeout 60s;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }
    location / { return 404; }
}
