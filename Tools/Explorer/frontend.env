ENVS_PRESET=none
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=3072
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0
PORT=3000
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_HOST=100.111.69.1
NEXT_PUBLIC_APP_PORT=8080
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=100.111.69.1
NEXT_PUBLIC_API_PORT=8080
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws
NEXT_PUBLIC_NETWORK_NAME=Dakota Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Dakota
NEXT_PUBLIC_NETWORK_ID=112311
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Dakota Coin
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=KOTA
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_PRO_API_SUPPORTED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]
NEXT_PUBLIC_HOMEPAGE_STATS=["total_blocks","average_block_time","total_txs","wallet_addresses","gas_tracker"]
NEXT_PUBLIC_USE_NEXT_JS_PROXY=false
NEXT_PUBLIC_NETWORK_RPC_URL=http://100.111.69.1:8080/api/eth-rpc
NEXT_PUBLIC_NAVIGATION_LAYOUT=horizontal
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_TRANSACTION_INTERPRETATION_PROVIDER=none
NEXT_PUBLIC_ADVANCED_FILTER_ENABLED=true
NEXT_PUBLIC_GAS_TRACKER_ENABLED=true
NEXT_PUBLIC_GAS_TRACKER_UNITS=["gwei"]
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_VIEWS_NFT_MARKETPLACES=[]
NEXT_PUBLIC_HELIA_VERIFIED_FETCH_ENABLED=false
NEXT_PUBLIC_IS_ACCOUNT_SUPPORTED=false
NEXT_PUBLIC_WEB3_WALLETS=["metamask"]
# Thirdweb wallet connection and contract writing (fork feature). Public client ID;
# supply the current value at install time and restrict its origins in the Thirdweb dashboard.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=<thirdweb-client-id>
